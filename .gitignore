# 本地缓存与产物, 不入库
__pycache__/
*.pyc
.DS_Store

# 行情缓存(yfinance CSV, 几万个小文件)
data_cache_daily/
data_cache_daily_5y/

# 虚拟环境
venv/

# 日志
*.log

# rps_pool 的中间产物(每日筛选/回测/看板), 交给主流水线把 result JSON 导出到 output/strategy
rps_pool/out/
rps_pool/data/
rps_pool/logs/

# 板块RPS: K线断点缓存(约550个小文件, 每次运行重取)与覆盖前备份, 不进版本库
sector_rps/data/kline_cache/
sector_rps/data/*.prev.json
# 图片每天重画且看板页面并不引用它们, 别把 4.5MB 二进制写进历史
sector_rps/data/*.png
